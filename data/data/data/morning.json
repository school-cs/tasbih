 = [

  {
    text: `أعوذ بالله من الشيطان الرجيم •
اللَّهُ لَا إِلَٰهَ إِلَّا هُوَ الْحَيُّ الْقَيُّومُ ۚ
لَا تَأْخُذُهُ سِنَةٌ وَلَا نَوْمٌ ۚ
لَّهُ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ ۗ
مَن ذَا الَّذِي يَشْفَعُ عِندَهُ إِلَّا بِإِذْنِهِ ۚ
يَعْلَمُ مَا بَيْنَ أَيْدِيهِمْ وَمَا خَلْفَهُمْ ۖ
وَلَا يُحِيطُونَ بِشَيْءٍ مِّنْ عِلْمِهِ إِلَّا بِمَا شَاءَ ۚ
وَسِعَ كُرْسِيُّهُ السَّمَاوَاتِ وَالْأَرْضَ ۖ
وَلَا يَئُودُهُ حِفْظُهُمَا ۚ
وَهُوَ الْعَلِيُّ الْعَظِيمُ`,
    repeat: 1
  },

  {
    text: `بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ •
قُلْ هُوَ اللَّهُ أَحَدٌ (1)
اللَّهُ الصَّمَدُ (2)
لَمْ يَلِدْ وَلَمْ يُولَدْ (3)
وَلَمْ يَكُن لَّهُ كُفُوًا أَحَدٌ (4)`,
    repeat: 3
  },

  {
    text: `بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ •
قُلْ أَعُوذُ بِرَبِّ الْفَلَقِ (1)
مِن شَرِّ مَا خَلَقَ (2)
وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ (3)
وَمِن شَرِّ النَّفَّاثَاتِ فِي الْعُقَدِ (4)
وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ (5)`,
    repeat: 3
  },

  {
    text: `بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ •
قُلْ أَعُوذُ بِرَبِّ النَّاسِ (1)
مَلِكِ النَّاسِ (2)
إِلَٰهِ النَّاسِ (3)
مِن شَرِّ الْوَسْوَاسِ الْخَنَّاسِ (4)
الَّذِي يُوَسْوِسُ فِي صُدُورِ النَّاسِ (5)
مِنَ الْجِنَّةِ وَالنَّاسِ (6)`,
    repeat: 3
  },

  {
    text: `أصبحنا وأصبح الملك لله، والحمد لله،
لا إله إلا الله وحده لا شريك له،
له الملك وله الحمد وهو على كل شيء قدير،
ربِّ أسألك خير ما في هذا اليوم وخير ما بعده،
وأعوذ بك من شر ما في هذا اليوم وشر ما بعده،
ربِّ أعوذ بك من الكسل وسوء الكِبَر،
ربِّ أعوذ بك من عذاب النار وعذاب القبر.`,
    repeat: 1
  },

  {
    text: `اللهم بك أصبحنا وبك أمسينا،
وبك نحيا وبك نموت وإليك النشور.`,
    repeat: 1
  },

  {
    text: `اللهم أنت ربي لا إله إلا أنت،
خلقتني وأنا عبدك،
وأنا على عهدك ووعدك ما استطعت،
أعوذ بك من شر ما صنعت،
أبوء لك بنعمتك عليَّ،
وأبوء بذنبي فاغفر لي
فإنه لا يغفر الذنوب إلا أنت.`,
    repeat: 1
  },

  {
    text: `اللهم إني أصبحت أُشهدك،
وأُشهد حملة عرشك،
وملائكتك وجميع خلقك،
أنك أنت الله لا إله إلا أنت وحدك لا شريك لك،
وأن محمدًا عبدك ورسولك.`,
    repeat: 4
  },

  {
    text: `اللهم ما أصبح بي من نعمة
أو بأحدٍ من خلقك فمنك وحدك لا شريك لك،
فلك الحمد ولك الشكر.`,
    repeat: 1
  },

  {
    text: `اللهم عافني في بدني،
اللهم عافني في سمعي،
اللهم عافني في بصري،
لا إله إلا أنت،
اللهم إني أعوذ بك من الكفر والفقر،
وأعوذ بك من عذاب القبر،
لا إله إلا أنت.`,
    repeat: 3
  },

  {
    text: `حسبي الله لا إله إلا هو
عليه توكلت وهو رب العرش العظيم.`,
    repeat: 7
  },

  {
    text: `اللهم إني أسألك العفو والعافية
في الدنيا والآخرة،
اللهم إني أسألك العفو والعافية
في ديني ودنياي وأهلي ومالي،
اللهم استر عوراتي وآمن روعاتي،
اللهم احفظني من بين يديَّ ومن خلفي،
وعن يميني وعن شمالي ومن فوقي،
وأعوذ بعظمتك أن أُغتال من تحتي.`,
    repeat: 1
  },

  {
    text: `اللهم عالم الغيب والشهادة،
فاطر السماوات والأرض،
رب كل شيء ومليكه،
أشهد أن لا إله إلا أنت،
أعوذ بك من شر نفسي،
ومن شر الشيطان وشِركه،
وأن أقترف على نفسي سوءًا
أو أجرّه إلى مسلم.`,
    repeat: 1
  },

  {
    text: `بسم الله الذي لا يضر مع اسمه شيء
في الأرض ولا في السماء
وهو السميع العليم.`,
    repeat: 3
  },

  {
    text: `رضيت بالله ربًا،
وبالإسلام دينًا،
وبمحمد ﷺ نبيًا.`,
    repeat: 3
  },

  {
    text: `يا حي يا قيوم،
برحمتك أستغيث،
أصلح لي شأني كله
ولا تكلني إلى نفسي طرفة عين.`,
    repeat: 1
  },

  {
    text: `أصبحنا على فطرة الإسلام،
وعلى كلمة الإخلاص،
وعلى دين نبينا محمد ﷺ،
وعلى ملة أبينا إبراهيم،
حنيفًا مسلمًا وما كان من المشركين.`,
    repeat: 1
  },

  {
    text: `سبحان الله وبحمده.`,
    repeat: 100
  },

  {
    text: `لا إله إلا الله وحده لا شريك له،
له الملك وله الحمد،
وهو على كل شيء قدير.`,
    repeat: 100
  },

  {
    text: `سبحان الله وبحمده:
عدد خلقه،
ورضا نفسه،
وزنة عرشه،
ومداد كلماته.`,
    repeat: 3
  },

  {
    text: `اللهم إني أسألك علمًا نافعًا،
ورزقًا طيبًا،
وعملًا متقبلًا.`,
    repeat: 1
  },

  {
    text: `أستغفر الله وأتوب إليه.`,
    repeat: 100
  },

  {
    text: `أعوذ بكلمات الله التامات
من شر ما خلق.`,
    repeat: 3
  },

  {
    text: `اللهم صلِّ وسلِّم على نبينا محمد ﷺ.`,
    repeat: 10
  }

]
